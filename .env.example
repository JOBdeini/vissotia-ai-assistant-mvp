# Copia este archivo como .env solo para desarrollo local.
# No publiques la clave ni la escribas en notebooks o código.
GEMINI_API_KEY=

GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=50
EMBEDDING_BATCH_DELAY_SECONDS=31
CHROMA_COLLECTION=vissotia_public_mvp
CHROMA_DIRECTORY=data/chroma
RAG_TOP_K=5
